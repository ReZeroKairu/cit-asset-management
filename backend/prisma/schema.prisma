generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model asset_details {
  detail_id        Int              @id @default(autoincrement())
  asset_id         Int              @unique
  property_tag_no  String?          @db.VarChar(50)
  quantity         Int?             @default(1)
  description      String?          @db.Text
  serial_number    String?          @db.VarChar(100)
  date_of_purchase DateTime?        @db.Date
  date_disposed    DateTime?        @db.Date
  disposed_by      String?          @db.VarChar(100)
  asset_remarks    String?          @db.Text
  status_id        Int?             @default(1)
  inventory_assets inventory_assets @relation(fields: [asset_id], references: [asset_id])
  asset_statuses   asset_statuses?  @relation(fields: [status_id], references: [status_id])

  @@index([asset_id])
  @@index([status_id])
}

model campuses {
  campus_id   Int           @id @default(autoincrement())
  campus_name String        @db.VarChar(50)
  departments departments[]
}

model complaints {
  complaint_id         Int               @id @default(autoincrement())
  lab_id               Int
  workstation_id       Int?
  asset_id             Int?
  faculty_student_name String            @db.VarChar(100)
  user_type            String            @db.VarChar(20)
  year_level           String?           @db.VarChar(20)
  issue_description    String            @db.Text
  asset_info           String?           @db.VarChar(50)
  status               complaints_status @default(Open)
  monitored_by         String?           @db.VarChar(100)
  approved_by          String?           @db.VarChar(100)
  custodian_user_id    Int?
  remarks              String?           @db.Text
  resolved_at          DateTime?
  created_at           DateTime          @default(now()) @db.Timestamp(0)
  updated_at           DateTime          @db.Timestamp(0)
  accepted_at          DateTime?         @db.Timestamp(0)
  inventory_assets     inventory_assets? @relation(fields: [asset_id], references: [asset_id])
  users                users?            @relation(fields: [custodian_user_id], references: [user_id])
  laboratories         laboratories      @relation(fields: [lab_id], references: [lab_id])
  workstations         workstations?     @relation(fields: [workstation_id], references: [workstation_id])

  @@index([created_at])
  @@index([custodian_user_id])
  @@index([lab_id])
  @@index([status])
  @@index([asset_id])
  @@index([workstation_id], map: "complaints_workstation_id_fkey")
}

model daily_report_procedures {
  id              Int           @id @default(autoincrement())
  report_id       Int
  procedure_id    Int
  overall_status  String        @default("Pending") @db.VarChar(50)
  overall_remarks String?       @db.Text
  created_at      DateTime?     @default(now()) @db.Timestamp(0)
  procedures      procedures    @relation(fields: [procedure_id], references: [procedure_id])
  daily_reports   daily_reports @relation(fields: [report_id], references: [report_id])

  @@index([procedure_id], map: "procedure_id")
  @@index([report_id], map: "report_id")
}

model daily_reports {
  report_id                Int                        @id @default(autoincrement())
  user_id                  Int
  lab_id                   Int
  report_date              DateTime                   @db.Date
  general_remarks          String?                    @db.Text
  status                   daily_reports_status?      @default(Pending)
  created_at               DateTime?                  @default(now()) @db.Timestamp(0)
  daily_report_procedures  daily_report_procedures[]
  laboratories             laboratories               @relation(fields: [lab_id], references: [lab_id])
  users                    users                      @relation(fields: [user_id], references: [user_id])
  report_workstation_items report_workstation_items[]

  @@index([lab_id], map: "lab_id")
  @@index([user_id], map: "user_id")
}

model departments {
  dept_id        Int            @id @default(autoincrement())
  dept_name      String         @db.VarChar(100)
  campus_id      Int?
  office_type_id Int?
  designee_name  String?        @db.VarChar(100)
  campuses       campuses?      @relation(fields: [campus_id], references: [campus_id])
  office_types   office_types?  @relation(fields: [office_type_id], references: [type_id])
  laboratories   laboratories[]

  @@index([campus_id], map: "campus_id")
  @@index([office_type_id], map: "office_type_id")
}

model device_types {
  device_type_id   Int     @id @default(autoincrement())
  device_type_name String  @db.VarChar(50)
  units            units[]
}


model inventory_assets {
  asset_id           Int                  @id @default(autoincrement())
  lab_id             Int?
  workstation_id     Int?
  unit_id            Int?
  added_by_user_id   Int?
  date_added         DateTime?            @default(now()) @db.Timestamp(0)
  asset_details      asset_details?
  complaints         complaints[]
  users              users?               @relation(fields: [added_by_user_id], references: [user_id])
  laboratories       laboratories?        @relation(fields: [lab_id], references: [lab_id])
  units              units?               @relation(fields: [unit_id], references: [unit_id])
  workstations       workstations?        @relation(fields: [workstation_id], references: [workstation_id])
  service_log_assets service_log_assets[]

  @@index([added_by_user_id], map: "added_by_user_id")
  @@index([workstation_id])
  @@index([lab_id], map: "lab_id")
  @@index([unit_id], map: "unit_id")
}

model maintenance_schedules {
  schedule_id     Int          @id @default(autoincrement())
  lab_id          Int
  quarter         String       @db.VarChar(20)
  fiscal_year     String       @db.VarChar(20)
  start_date      DateTime     @db.Date
  end_date        DateTime     @db.Date
  servicing_weeks Json
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  laboratories    laboratories @relation(fields: [lab_id], references: [lab_id])

  @@unique([lab_id, quarter, fiscal_year])
  @@index([lab_id])
  @@index([quarter])
  @@index([fiscal_year])
}

model laboratories {
  lab_id                Int                     @id @default(autoincrement())
  lab_name              String                  @db.VarChar(50)
  location              String?                 @db.VarChar(50)
  dept_id               Int?
  in_charge_id          Int?
  complaints            complaints[]
  daily_reports         daily_reports[]
  inventory_assets      inventory_assets[]
  departments           departments?            @relation(fields: [dept_id], references: [dept_id], map: "fk_lab_dept")
  maintenance_schedules maintenance_schedules[]
  pmc_reports           pmc_reports[]
  users                 users[]
  workstations          workstations[]

  @@index([dept_id], map: "dept_id")
  @@index([in_charge_id])
}

model office_types {
  type_id     Int           @id @default(autoincrement())
  type_name   String        @unique(map: "type_name") @db.VarChar(50)
  departments departments[]
}


model pmc_report_procedures {
  id           Int         @id @default(autoincrement())
  pmc_id       Int
  procedure_id Int
  is_checked   Boolean     @default(true)
  remarks      String?     @db.VarChar(255)
  pmc_reports  pmc_reports @relation(fields: [pmc_id], references: [pmc_id], onDelete: Cascade)
  procedures   procedures  @relation(fields: [procedure_id], references: [procedure_id])

  @@index([pmc_id])
  @@index([procedure_id])
}

model pmc_reports {
  pmc_id                    Int                     @id @default(autoincrement())
  report_date               DateTime                @db.Date
  quarter                   String                  @db.VarChar(20)
  lab_id                    Int
  user_id                   Int
  workstation_id            Int
  workstation_status        String                  @default("Functional") @db.VarChar(50)
  overall_remarks           String?                 @db.Text
  software_name             String?                 @db.VarChar(100)
  software_status           String?                 @default("Functional") @db.VarChar(50)
  connectivity_type         String?                 @db.VarChar(50)
  connectivity_type_status  String?                 @default("Functional") @db.VarChar(50)
  connectivity_speed        String?                 @db.VarChar(50)
  connectivity_speed_status String?                 @default("Functional") @db.VarChar(50)
  service_count             Int                     @default(1)
  updated_at                DateTime
  created_at                DateTime                @default(now())
  pmc_report_procedures     pmc_report_procedures[]
  laboratories              laboratories            @relation(fields: [lab_id], references: [lab_id])
  users                     users                   @relation(fields: [user_id], references: [user_id])
  workstations              workstations            @relation(fields: [workstation_id], references: [workstation_id])
  service_logs              service_logs[]

  @@index([lab_id])
  @@index([user_id])
  @@index([workstation_id])
}

model procedures {
  procedure_id            Int                       @id @default(autoincrement())
  procedure_name          String                    @db.VarChar(100)
  category                String?                   @db.VarChar(50)
  is_active               Boolean                   @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamp(0)
  daily_report_procedures daily_report_procedures[]
  pmc_report_procedures   pmc_report_procedures[]
  service_log_procedures  service_log_procedures[]

  @@index([procedure_id])
}

model report_workstation_items {
  item_id        Int           @id @default(autoincrement())
  report_id      Int
  workstation_id Int
  status         String        @default("Working") @db.VarChar(50)
  remarks        String?       @db.Text
  created_at     DateTime?     @default(now()) @db.Timestamp(0)
  daily_reports  daily_reports @relation(fields: [report_id], references: [report_id])
  workstations   workstations  @relation(fields: [workstation_id], references: [workstation_id])

  @@index([report_id], map: "report_id")
  @@index([workstation_id], map: "workstation_id")
}

model asset_statuses {
  status_id     Int             @id @default(autoincrement())
  status_name   String          @unique @db.VarChar(50)
  asset_details asset_details[]
  workstations  workstations[]

  @@map("asset_statuses")
}


model service_log_assets {
  id                   Int              @id @default(autoincrement())
  log_id               Int
  asset_id             Int
  action               String           @db.VarChar(30)
  status_before        String?          @db.VarChar(50)
  status_after         String?          @db.VarChar(50)
  remarks              String?          @db.Text
  old_property_tag     String?          @db.VarChar(50)
  new_property_tag     String?          @db.VarChar(50)
  replacement_asset_id Int?
  inventory_assets     inventory_assets @relation(fields: [asset_id], references: [asset_id])
  service_logs         service_logs     @relation(fields: [log_id], references: [log_id], onDelete: Cascade)

  @@index([asset_id])
  @@index([log_id])
}

model service_log_procedures {
  id           Int          @id @default(autoincrement())
  log_id       Int
  procedure_id Int
  is_checked   Boolean      @default(true)
  remarks      String?      @db.VarChar(255)
  service_logs service_logs @relation(fields: [log_id], references: [log_id], onDelete: Cascade)
  procedures   procedures   @relation(fields: [procedure_id], references: [procedure_id])

  @@index([log_id])
  @@index([procedure_id])
}

model service_logs {
  log_id                    Int                      @id @default(autoincrement())
  pmc_id                    Int
  service_type              String                   @db.VarChar(30)
  service_date              DateTime                 @db.Date
  performed_by              Int
  remarks                   String?                  @db.Text
  workstation_status_before String?                  @db.VarChar(50)
  workstation_status_after  String?                  @db.VarChar(50)
  created_at                DateTime                 @default(now())
  service_log_assets        service_log_assets[]
  service_log_procedures    service_log_procedures[]
  users                     users                    @relation(fields: [performed_by], references: [user_id])
  pmc_reports               pmc_reports              @relation(fields: [pmc_id], references: [pmc_id], onDelete: Cascade)

  @@index([performed_by])
  @@index([pmc_id])
  @@index([service_date])
}

model software_installations {
  id                   Int                           @id @default(autoincrement())
  user_id              Int?
  faculty_name         String                        @db.VarChar(100)
  date                 DateTime                      @db.Date
  laboratory           String                        @db.VarChar(20)
  software_list        String                        @db.Text
  requested_by         String                        @db.VarChar(100)
  installation_remarks String?                       @db.Text
  prepared_by          String?                       @db.VarChar(100)
  feedback_date        DateTime?                     @db.Date
  status               software_installations_status @default(Pending)
  created_at           DateTime                      @default(now()) @db.Timestamp(0)
  users                users?                        @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

model units {
  unit_id          Int                @id @default(autoincrement())
  unit_name        String             @db.VarChar(50)
  device_type_id   Int
  inventory_assets inventory_assets[]
  device_types     device_types       @relation(fields: [device_type_id], references: [device_type_id])

  @@index([device_type_id], map: "device_type_id")
}

model users {
  user_id                Int                      @id @default(autoincrement())
  full_name              String                   @db.VarChar(100)
  email                  String                   @unique(map: "email") @db.VarChar(100)
  password_hash          String                   @db.VarChar(255)
  role                   users_role?              @default(Custodian)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  lab_id                 Int?
  audit_logs             audit_logs[]
  complaints             complaints[]
  daily_reports          daily_reports[]
  inventory_assets       inventory_assets[]
  pmc_reports            pmc_reports[]
  service_logs           service_logs[]
  software_installations software_installations[]
  laboratories           laboratories?            @relation(fields: [lab_id], references: [lab_id])

  @@index([lab_id], map: "users_lab_id_fkey")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  lab_id      Int?
  action      String   @db.VarChar(50)
  description String?  @db.Text
  created_at  DateTime @default(now())
  user_agent  String?  @db.Text
  users       users?   @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([lab_id])
}

model workstations {
  workstation_id           Int                        @id @default(autoincrement())
  workstation_name         String                     @db.VarChar(100)
  lab_id                   Int?
  created_at               DateTime                   @default(now())
  status_id                Int?                       @default(1)
  workstation_remarks      String?                    @db.Text
  complaints               complaints[]
  inventory_assets         inventory_assets[]
  pmc_reports              pmc_reports[]
  report_workstation_items report_workstation_items[]
  laboratories             laboratories?              @relation(fields: [lab_id], references: [lab_id])
  asset_statuses           asset_statuses?            @relation(fields: [status_id], references: [status_id])

  @@unique([workstation_name, lab_id])
  @@index([lab_id])
  @@index([status_id])
}

model cit_lab_logs {
  log_id               Int      @id @default(autoincrement())
  date                 DateTime @db.Date
  time_in              String   @db.VarChar(5)  // HH:MM format
  time_out             String?  @db.VarChar(5)  // HH:MM format, optional
  usage_type           String   @db.VarChar(20)
  faculty_student_name String   @db.VarChar(100)
  year_level           String?  @db.VarChar(20)
  laboratory           String   @db.VarChar(20)
  ws_number            String?  @db.VarChar(50)
  purpose              String   @db.Text
  monitored_by         String?  @db.VarChar(100)
  user_type            String?  @db.VarChar(20)
  created_at           DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at])
  @@index([laboratory])
  @@index([date])
  @@index([time_in])
}

enum users_role {
  Admin
  Custodian
}

enum daily_reports_status {
  Pending
  Approved
}

enum complaints_status {
  Open
  In_Progress
  Resolved
  Denied
}

enum software_installations_status {
  Pending
  Custodian_Approved
  Denied
  Completed
}



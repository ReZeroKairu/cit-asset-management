@echo off
title CIT Asset Management - Production
color 0C
echo.
echo ========================================
echo   CIT Asset Management
echo   Production Server Monitor
echo ========================================
echo.

REM Configuration
set "APP_NAME=CIT Asset Management"
set "APP_DIR=C:\CIT_AM_Server\cit-asset-management"
set "BACKEND_PORT=3001"
set "FRONTEND_PORT=5173"
set "FRONTEND_IP=172.72.100.78"
set "LOG_FILE=%APP_DIR%\server-status.log"
set "MAX_RESTART_ATTEMPTS=3"
set "RESTART_DELAY=30"

REM Create log file if not exists
if not exist "%LOG_FILE%" (
    echo [INFO] Creating log file... > "%LOG_FILE%"
)

:MAIN_LOOP
echo [%DATE% %TIME%] [INFO] Starting server health check... >> "%LOG_FILE%"

REM Check if servers are running
call :CHECK_SERVERS

if "%BACKEND_RUNNING%"=="true" (
    if "%FRONTEND_RUNNING%"=="true" (
        echo [%DATE% %TIME%] [INFO] Both servers are running normally >> "%LOG_FILE%"
        goto :WAIT_CYCLE
    )
)

REM Start missing servers
call :START_SERVERS

:WAIT_CYCLE
echo [%DATE% %TIME%] [INFO] Monitoring servers (checking every 60 seconds)... >> "%LOG_FILE%"
timeout /t 60 /nobreak >nul
goto :MAIN_LOOP

:CHECK_SERVERS
set "BACKEND_RUNNING=false"
set "FRONTEND_RUNNING=false"

REM Check backend server (port 3001)
netstat -an | findstr ":3001" >nul
if not errorlevel 1 set "BACKEND_RUNNING=true"

REM Check frontend server (port 5173)  
netstat -an | findstr ":5173" >nul
if not errorlevel 1 set "FRONTEND_RUNNING=true"

echo [%DATE% %TIME%] [DEBUG] Backend: %BACKEND_RUNNING%, Frontend: %FRONTEND_RUNNING% >> "%LOG_FILE%"
goto :EOF

:START_SERVERS
set "RESTART_COUNT=0"

:RESTART_BACKEND
if "%BACKEND_RUNNING%"=="false" (
    set /a "RESTART_COUNT+=1"
    echo [%DATE% %TIME%] [WARN] Backend server down! Attempt %RESTART_COUNT% of %MAX_RESTART_ATTEMPTS% >> "%LOG_FILE%"
    
    if %RESTART_COUNT% GTR %MAX_RESTART_ATTEMPTS% (
        echo [%DATE% %TIME%] [ERROR] Max restart attempts reached for backend! >> "%LOG_FILE%"
        call :SEND_ALERT "Backend server failed to start after %MAX_RESTART_ATTEMPTS% attempts"
        goto :RESTART_FRONTEND
    )
    
    echo [%DATE% %TIME%] [INFO] Starting backend server... >> "%LOG_FILE%"
    start "Backend Recovery" /MIN cmd /k "cd /d "%APP_DIR%\backend" && npm run dev"
    
    echo [%DATE% %TIME%] [INFO] Waiting %RESTART_DELAY% seconds for backend to initialize... >> "%LOG_FILE%"
    timeout /t %RESTART_DELAY% /nobreak >nul
    
    call :CHECK_SERVERS
    if "%BACKEND_RUNNING%"=="false" goto :RESTART_BACKEND
)

:RESTART_FRONTEND
if "%FRONTEND_RUNNING%"=="false" (
    set /a "RESTART_COUNT+=1"
    echo [%DATE% %TIME%] [WARN] Frontend server down! Attempt %RESTART_COUNT% of %MAX_RESTART_ATTEMPTS% >> "%LOG_FILE%"
    
    if %RESTART_COUNT% GTR %MAX_RESTART_ATTEMPTS% (
        echo [%DATE% %TIME%] [ERROR] Max restart attempts reached for frontend! >> "%LOG_FILE%"
        call :SEND_ALERT "Frontend server failed to start after %MAX_RESTART_ATTEMPTS% attempts"
        goto :EOF
    )
    
    echo [%DATE% %TIME%] [INFO] Starting frontend server... >> "%LOG_FILE%"
    start "Frontend Recovery" /MIN cmd /k "cd /d "%APP_DIR%\frontend" && npm run dev"
    
    echo [%DATE% %TIME%] [INFO] Waiting %RESTART_DELAY% seconds for frontend to initialize... >> "%LOG_FILE%"
    timeout /t %RESTART_DELAY% /nobreak >nul
    
    call :CHECK_SERVERS
    if "%FRONTEND_RUNNING%"=="false" goto :RESTART_FRONTEND
)

goto :EOF

:SEND_ALERT
echo [%DATE% %TIME%] [CRITICAL] %~1 >> "%LOG_FILE%"
REM You can add email/notification logic here
REM For now, just show a persistent alert
echo.
echo ========================================
echo   ALERT: %~1
echo ========================================
echo.
echo Press any key to acknowledge...
pause >nul
goto :EOF

:CLEANUP
echo [%DATE% %TIME%] [INFO] Server monitor stopped >> "%LOG_FILE%"
exit /b 0

:EOF
